# === Variables de entorno del backend JuntaGO ===
# Copia este archivo como .env (local) o configura estas variables en Render (Environment).

# ID de la hoja de Google Sheets que actua como base de datos
SPREADSHEET_ID=tu_spreadsheet_id

# Secreto para firmar los tokens JWT. OBLIGATORIO en produccion.
# Genera uno aleatorio largo, por ejemplo con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# (Opcional) Duracion del token. Por defecto 30d.
JWT_EXPIRES_IN=30d

# Credenciales del Service Account de Google (JSON en una sola linea).
# RECOMENDADO en produccion en vez del archivo credentials.json.
# Pega aqui el contenido completo del JSON de la cuenta de servicio NUEVA (tras rotar la anterior).
# GOOGLE_CREDENTIALS={"type":"service_account", ... }

# (Opcional) Restringe CORS a tus dominios (separados por coma). Si se deja vacio, se permite cualquier origen.
# FRONTEND_ORIGINS=https://juntago.com,https://www.juntago.com

# Puerto (Render lo define automaticamente)
# PORT=3001

# === Freno y memoria de las lecturas de Google Sheets (Backend/hoja.js) ===
# Google corta a unas 60 lecturas por minuto para la cuenta de servicio. Sin
# freno, unas treinta pulsaciones seguidas dejaban la app sin leer para TODO el
# grupo durante un minuto. Los valores por defecto sirven para un piloto; solo
# hay que tocarlos si Render devuelve 429 con frecuencia.

# Cuanto vale una lectura guardada en memoria, en milisegundos (0 = sin memoria)
SHEETS_CACHE_MS=12000

# Lecturas por minuto que se dejan salir hacia Google
SHEETS_MAX_POR_MINUTO=50

# Lo maximo que una peticion espera su turno antes de responder 429
SHEETS_ESPERA_MAX_MS=15000

# Minutos que dura una sesion para el recuento de entradas del informe
SESION_MINUTOS=30

# Donde se guardan las FOTOS de los comprobantes de pago.
# En un ordenador se puede dejar vacio (se usa Backend/uploads).
# En Render HAY QUE apuntarlo al disco persistente montado, o cada despliegue
# borra el historico de evidencias y "Ver evidencia" empieza a dar 404 para
# todos los pagos anteriores. Ver render.yaml en la raiz del proyecto.
# UPLOADS_DIR=/var/data
