# === Variables de entorno del backend JuntaGO ===
# Copia este archivo como .env (local) o configura estas variables en Render (Environment).

# ID de la hoja de Google Sheets que actua como base de datos
SPREADSHEET_ID=tu_spreadsheet_id

# Secreto para firmar los tokens JWT. OBLIGATORIO en produccion.
# Genera uno aleatorio largo, por ejemplo con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# (Opcional) Duracion del token. Por defecto 30d.
JWT_EXPIRES_IN=30d

# Credenciales del Service Account de Google (JSON en una sola linea).
# RECOMENDADO en produccion en vez del archivo credentials.json.
# Pega aqui el contenido completo del JSON de la cuenta de servicio NUEVA (tras rotar la anterior).
# GOOGLE_CREDENTIALS={"type":"service_account", ... }

# (Opcional) Restringe CORS a tus dominios (separados por coma). Si se deja vacio, se permite cualquier origen.
# FRONTEND_ORIGINS=https://juntago.com,https://www.juntago.com

# Puerto (Render lo define automaticamente)
# PORT=3001
